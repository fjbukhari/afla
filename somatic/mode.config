// AFLA somatic workflow: overrides the germline defaults in nextflow.config.
params {
    mode = "somatic"
    report_name = "afla-somatic-report.html"
    report_min_vaf = 0.02
    min_dp = 50
    report_max_pop_af = 0.001
}
manifest {
    name = "fjbukhari/afla-somatic"
    description = "Somatic small-variant analysis of Illumina panels (tumour-only or tumour/normal, GATK Mutect2) with a teaching report. Not for clinical use."
}
