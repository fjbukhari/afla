// AFLA workflows (Illumina/DNBSEQ short reads) for EPI2ME Desktop: germline and somatic analysis of
// gene panels and exomes. Education and research use only, not for clinical use.

params {
    // ---------------------------------------------------------------- analysis
    mode = "germline"              // germline | somatic (conf/mode.config may override for the installed somatic copy)

    // ---------------------------------------------------------------- input: exactly one of fastq / bam / vcf
    fastq = null
    bam = null
    vcf = null
    sample_name = null
    samplesheet = null             // optional CSV: sample,role,sex,family,hpo (trios, tumour/normal pairs, phenotypes)

    // ---------------------------------------------------------------- resources
    resources_dir = null           // folder made by scripts/afla-setup.sh; fills in every resource below that is left empty
    ref = null
    bed = null
    bed_padding = 100
    auto_targets_min_depth = 20
    build_bwa_index = false

    // ---------------------------------------------------------------- library type
    amplicon = false               // amplicon (PCR) panel: no duplicate marking, primer clipping if primers are known
    primer_bed = null              // primer coordinates (BED, strand in column 6 if known)
    amplicon_bed = null            // whole amplicons incl. primers; with 'bed' = inserts, primers are derived
    umi_mode = "none"              // none | inline | read_name
    umi_read_structure = "+T +T"   // fgbio read structures (R1 R2) for inline UMIs, e.g. "+T 12M11S+T" (QIAseq: UMI on read 2)
    umi_min_reads = null           // reads per UMI family for a consensus read (default: germline 1, somatic 2)

    // ---------------------------------------------------------------- steps
    run_fastp = true
    mark_duplicates = true
    run_coverage = true
    run_calling = true
    caller = "gatk"                // gatk | deepvariant (germline)
    deepvariant_model = "WES"
    deepvariant_version = "1.9.0"
    use_gpu = true
    run_annotation = true
    run_cnv = true
    cnv_reference = null           // CNVkit reference (.cnn) built from normal samples of the same kit
    run_sv = false                 // Manta structural variants / DNA fusions
    run_roh = true                 // runs of homozygosity (germline)
    run_msi = true                 // microsatellite instability (somatic)
    msi_list = null                // msisensor-pro microsatellite list (made once from the reference if empty)
    msi_baseline = null            // optional msisensor-pro tumour-only baseline built from normals
    run_report = true

    // ---------------------------------------------------------------- variant filters (null = mode default)
    min_qual = 30
    min_dp = null                  // germline 10, somatic 50
    min_gq = 20
    min_het_vaf = 0.2              // germline: heterozygous calls below this allele fraction are labelled LowVAF (artefacts)

    // ---------------------------------------------------------------- annotation
    vep_cache = null
    vep_cache_version = 115
    vep_gtf = null                 // alternative to the cache: bgzipped GTF (lean installs, tests)
    vep_fasta = null
    vep_plugins_dir = null
    clinvar_vcf = null
    revel_file = null
    alphamissense_file = null
    spliceai_snv = null
    spliceai_indel = null
    gnomad_vcf = null              // optional extra gnomAD VCF (needed with vep_gtf, the cache already has gnomAD)
    gnomad_constraint = null       // gnomAD constraint table (LOEUF, missense Z): ACMG PVS1/PP2
    clinvar_protein_index = null   // ClinVar pathogenic amino-acid changes: ACMG PS1/PM5
    hpo_dir = null                 // hp.obo + genes_to_phenotype.txt
    refflat = null                 // gene models (UCSC/GENCODE refFlat): gene names for CNVs, coding size for TMB
    panelapp_dir = null

    // ---------------------------------------------------------------- case information (germline tertiary)
    case_id = null
    hpo_terms = null               // e.g. "HP:0001250, HP:0001263"
    gene_list = null               // gene list file, or genes separated by commas
    ped = null                     // PED file (trio/family); a samplesheet can be used instead

    // ---------------------------------------------------------------- somatic
    normal_sample = null
    tumour_type = null             // free text, e.g. "acute myeloid leukaemia"; used to match evidence
    min_vaf = 0.02
    min_alt_reads = 5
    mutect2_shards = 1
    germline_resource = null
    panel_of_normals = null
    civic_dir = null               // CIViC nightly TSVs (CC0)
    cosmic_file = null             // optional COSMIC Cancer Mutation Census / coding mutations (user download, licence)
    oncokb_token = null            // optional OncoKB API token (free academic licence); needs internet
    tmb_min_vaf = 0.05

    // ---------------------------------------------------------------- report (null = mode default)
    report_name = null
    report_max_pop_af = null
    report_min_vaf = null

    // ---------------------------------------------------------------- output and machine size
    out_dir = "output"
    output_format = "cram"
    max_cpus = null                // default: all CPUs this machine has
    max_memory = null              // default: 85% of this machine's memory
    threads = null                 // cap for the heaviest single steps (default: max_cpus)

    help = false
    version = false
    disable_ping = true
}

// machine size, detected once (can be overridden: --max_cpus 8 --max_memory "30 GB")
params.max_cpus = params.max_cpus ?: Runtime.getRuntime().availableProcessors()
params.max_memory = params.max_memory ?: "${Math.max(2L, Math.round(java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize() * 0.85 / 1073741824))} GB"

manifest {
    name = "fjbukhari/afla"
    author = "AFLA project"
    homePage = "https://github.com/fjbukhari/afla"
    description = "Germline and somatic analysis of short-read gene panels and exomes with a teaching report. Not for clinical use."
    mainScript = "main.nf"
    nextflowVersion = ">=23.04.0"
    version = "0.3.0"
}

process {
    shell = ["/bin/bash", "-euo", "pipefail"]
    // every request is capped at what the machine has, so the same workflow runs on 8 GB and 64 GB laptops
    cpus = 1
    memory = { [MemoryUnit.of("2 GB"), MemoryUnit.of(params.max_memory.toString())].min() }
    withLabel: "medium" {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { [MemoryUnit.of("8 GB"), MemoryUnit.of(params.max_memory.toString())].min() }
    }
    withLabel: "big" {
        cpus = { Math.min((params.threads ?: params.max_cpus) as int, params.max_cpus as int) }
        memory = { [MemoryUnit.of("24 GB"), MemoryUnit.of(params.max_memory.toString())].min() }
    }
    withLabel: "gpu" {
        containerOptions = { params.use_gpu.toString() == "true" ? "--gpus all" : "" }
    }
}

executor {
    cpus = params.max_cpus
    memory = params.max_memory
}

profiles {
    // "standard" is the profile EPI2ME Desktop uses: every step runs in its Docker container
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }
    // tools installed locally (conda/mamba) instead of containers; see tests/README.md
    local {
        docker.enabled = false
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/trace.txt"
}

// germline by default; the installed "AFLA somatic" copy replaces this file (scripts/install-epi2me.sh)
includeConfig "conf/mode.config"
