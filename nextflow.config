// AFLA germline workflow (Illumina short reads) for EPI2ME Desktop.
// Education and research use only, not for clinical use.

params {
    // input: give exactly one of fastq / bam / vcf (this also sets where the workflow starts)
    fastq = null
    bam = null
    vcf = null
    sample_name = null

    // reference and targets
    ref = null
    bed = null
    bed_padding = 100
    auto_targets_min_depth = 20
    build_bwa_index = false

    // steps
    run_fastp = true
    mark_duplicates = true
    run_coverage = true
    run_calling = true
    caller = "gatk"
    deepvariant_model = "WES"
    deepvariant_version = "1.9.0"
    use_gpu = true
    run_annotation = true
    run_report = true

    // variant quality filter (soft filter: failing calls are kept but labelled LowQual)
    min_qual = 30
    min_dp = 10
    min_gq = 20

    // annotation (Ensembl VEP offline cache + optional extra sources)
    vep_cache = null
    vep_cache_version = 115
    vep_fasta = null
    vep_plugins_dir = null
    clinvar_vcf = null
    revel_file = null
    alphamissense_file = null

    // report defaults (all adjustable inside the report)
    report_max_pop_af = 0.01
    report_min_vaf = 0.2

    // output and resources
    out_dir = "output"
    output_format = "cram"
    threads = 12

    help = false
    version = false
    disable_ping = true
}

manifest {
    name = "fjbukhari/afla"
    author = "AFLA project"
    homePage = "https://github.com/fjbukhari/afla"
    description = "Germline small-variant analysis of Illumina short reads (panels and exomes) with a teaching report. Not for clinical use."
    mainScript = "main.nf"
    nextflowVersion = ">=23.04.0"
    version = "0.1.0"
}

process {
    shell = ["/bin/bash", "-euo", "pipefail"]
    cpus = 2
    memory = "4 GB"
    withLabel: "big" {
        cpus = { params.threads }
        memory = "24 GB"
    }
    withName: "BWA_INDEX" {
        memory = "8 GB"
    }
    withLabel: "gpu" {
        containerOptions = { params.use_gpu.toString() == "true" ? "--gpus all" : "" }
    }
}

executor {
    cpus = params.threads
    memory = "44 GB"
}

profiles {
    // "standard" is the profile EPI2ME Desktop uses
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/trace.txt"
}
